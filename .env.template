# Weena Loft — System Configuration Template
# Copy this file to '.env' and modify with your production details. Do not check '.env' into version control.

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=*

# Africa's Talking API Credentials
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key

# SMS Webhook Security Token
SMS_WEBHOOK_TOKEN=your_secure_random_webhook_token_here

# Landlord Operational Details
LANDLORDS=Landlords Name e.g. Osanya F and Osiko R
BANK_NAME=Your Bank Name e.g. Absa Bank Queensway
BANK_ACC=Your Bank Account Number
PAYBILL=Your Paybill Number
OPS_PHONE=Operations Manager Phone Number
